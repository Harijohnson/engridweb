# Django backend origin used by the /api/* rewrite in next.config.ts (server-side, read at
# build time: changing it needs a rebuild / Vercel redeploy). No trailing slash, no path.
# Local: http://127.0.0.1:8000   Vercel (Production + Preview): https://<username>.pythonanywhere.com
API_ORIGIN=http://127.0.0.1:8000
